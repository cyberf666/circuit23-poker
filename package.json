{
  "name": "ntp-poker",
  "version": "0.1.0",
  "private": true,
  "description": "CIRCUIT 23 - NEOTOKYOPUNKS World Texas Hold'em (hosted by FUTURE Guild)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @ntp-poker/web dev",
    "dev:server": "pnpm --filter @ntp-poker/server dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "next": "16.2.6",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
